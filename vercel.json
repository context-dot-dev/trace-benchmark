{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,.venv/**,.env*,.vercel_python_packages/**,_uv/**,artifacts/**,state/**,site/**,server/**,src/**,**/._*}",
      "memory": 4096
    },
    "api/dashboard.js": {
      "maxDuration": 60,
      "includeFiles": "{server/render/**,site/index.html}"
    },
    "api/publish.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/export",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/publish",
      "schedule": "2-59/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/dashboard"
    },
    {
      "source": "/index.html",
      "destination": "/api/dashboard"
    },
    {
      "source": "/api/:path(summary|results|result|download)",
      "destination": "/api/dashboard"
    },
    {
      "source": "/data/:path*",
      "destination": "/api/dashboard"
    }
  ]
}

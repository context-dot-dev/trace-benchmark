{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "15 0 * * 5"
    },
    {
      "path": "/api/discover",
      "schedule": "45 12 * * *"
    }
  ]
}

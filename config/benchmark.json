{
  "name": "TRACE",
  "version": "trace-live-v3",
  "providers": [
    "context",
    "exa",
    "firecrawl",
    "keenable"
  ],
  "browser_reference": false,
  "description": "3,000 independent pages plus up to 400 search-result slots daily; category and domain caps apply, supply and budget shortfalls remain visible.",
  "execution": {
    "page_concurrency": 64,
    "host_concurrency": 8,
    "global_interval_seconds": 0.05,
    "host_interval_seconds": 0.25,
    "judge_concurrency": 16,
    "reference_judge_concurrency": 8
  },
  "pipeline_scoring": true,
  "output_comparison": "observed-output-pairwise-v1"
}

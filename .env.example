DATABASE_URL=postgresql://user:password@neon-host/scraping_bench?sslmode=verify-full
BENCHMARK_DATA_ORIGIN=
CONTEXT_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
KEENABLE_API_KEY=
TYPESAFE_API_KEY=
CRON_SECRET=
TRACE_WORKER_ENABLED=0

# Aggregate provider limits across all workflow shards. Raise only to account allowances.
TRACE_CONTEXT_CONCURRENCY=512
TRACE_CONTEXT_RPS=10
TRACE_EXA_CONCURRENCY=512
TRACE_EXA_RPS=5
TRACE_FIRECRAWL_CONCURRENCY=50
TRACE_FIRECRAWL_RPS=100
TRACE_KEENABLE_CONCURRENCY=100
TRACE_KEENABLE_RPS=8
TRACE_JUDGE_RPS=200

# Document and content grades for the Quality section (one extra judge call per accessed page).
TRACE_QUALITY_GRADING=0
# Retention of grading evidence and page-level records.
TRACE_EVIDENCE_DAYS=30
TRACE_EVIDENCE_MAX_MB=900
TRACE_RECORD_DAYS=180

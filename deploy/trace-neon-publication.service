[Unit]
Description=Publish Scraping Bench public results to Neon
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Restart=on-failure
RestartSec=15
User=trace-bench
Group=trace-bench
WorkingDirectory=/opt/trace-bench
EnvironmentFile=/etc/trace-bench-neon.env
ExecStart=/opt/trace-bench/runtime/node/bin/node --import tsx server/publish.ts site/data/latest.json --sync-public-files
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=1G
TimeoutStartSec=300

[Unit]
Description=TRACE server-rendered benchmark dashboard
After=network.target

[Service]
Type=simple
User=trace-bench
Group=trace-bench
WorkingDirectory=/opt/trace-bench
Environment=PORT=18090
Environment=TRACE_DASHBOARD_BACKEND=artifact
Environment=TRACE_SITE=/opt/trace-bench/site
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/opt/trace-bench/runtime/node/bin/node /opt/trace-bench/node_modules/tsx/dist/cli.mjs /opt/trace-bench/server/index.ts
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
